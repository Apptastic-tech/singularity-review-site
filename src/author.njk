---
layout: layouts/base.njk
pagination:
  data: collections.authors
  size: 1
  alias: person
permalink: "/authors/{{ person.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ person.name }}"
  description: "Articles by {{ person.name }} for Singularity Review: AI news for people living through the singularity."
---
<header class="feed-intro category-intro feed-width">
  <p class="kicker">Author</p>
  <h1>{{ person.name }}</h1>
  <p class="meta">{{ person.articles.length }} {{ "article" if person.articles.length == 1 else "articles" }} for Singularity Review, newest first</p>
</header>
<section class="feed feed-width" aria-label="Articles by {{ person.name }}" data-feed>
  {% asyncEach item in person.articles %}{% set featured = loop.first %}{% include "card.njk" %}{% endeach %}
</section>
