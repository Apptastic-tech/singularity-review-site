{% from "icons.njk" import icon, socialLink %}
{%- set pageTitle = (title + " | " + site.title) if title else (site.title + ": " + site.tagline) -%}
{%- set pageDescription = description or site.description -%}
{%- set pageImage = (hero or site.defaultImage) | absoluteUrl(site.url) -%}
{%- set pageImageAlt = heroAlt or site.defaultImageAlt -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#0B0C0E">
  <meta name="color-scheme" content="dark">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if ogType == 'article' else 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageImageAlt }}">
  <meta property="og:image:width" content="{{ 1280 if hero else 1200 }}">
  <meta property="og:image:height" content="{{ 720 if hero else 630 }}">
  <meta property="og:locale" content="en_US">
  {% if ogType == 'article' %}<meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:section" content="{{ category }}">
  {% if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ pageImageAlt }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/rss.xml">
  <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% if hero %}{% preloadHero hero, "(min-width: 1152px) 1120px, 100vw", title %}
  {% elif feedItems and feedItems.length %}{% preloadHero feedItems[0].data.hero, "(min-width: 776px) 760px, calc(100vw - 16px)", feedItems[0].data.title %}
  {% elif cat and cat.articles.length %}{% preloadHero cat.articles[0].data.hero, "(min-width: 776px) 760px, calc(100vw - 16px)", cat.articles[0].data.title %}{% endif %}
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/site.js" defer></script>
  {% if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Singularity Review home"><img src="/images/brand/wordmark.svg" width="292" height="28" alt="Singularity Review"></a>
      <nav class="desktop-nav" aria-label="Primary"><a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>{{ socialLink(site.facebook, "Facebook") }}{{ socialLink(site.instagram, "Instagram") }}</nav>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" hidden data-menu-toggle><span></span><span></span></button>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Main menu" hidden data-menu>
      <a href="/">Latest</a><a href="/about/">About</a>
      {% for section in collections.categories %}<a href="/category/{{ section.slug }}/">{{ section.name }}</a>{% endfor %}
      <div class="menu-social">{{ socialLink(site.facebook, "Facebook", true) }}{{ socialLink(site.instagram, "Instagram", true) }}<a href="/rss.xml">{{ icon("RSS") }}<span>RSS</span></a></div>
    </nav>
    <nav class="chip-bar" aria-label="Categories"><div class="chip-inner">
      <a class="chip" href="/" {% if homeFeed %}aria-current="page"{% endif %}>All</a>
      {% for section in collections.categories %}<a class="chip" href="/category/{{ section.slug }}/" {% if (cat and cat.slug == section.slug) or (category and category == section.name) %}aria-current="{{ 'page' if cat else 'true' }}"{% endif %}>{{ section.name }}</a>{% endfor %}
    </div></nav>
  </header>
  <noscript><nav class="no-js-nav" aria-label="Primary"><a href="/">Latest</a><a href="/about/">About</a><a href="/rss.xml">RSS</a>{{ socialLink(site.facebook, "Facebook", true) }}{{ socialLink(site.instagram, "Instagram", true) }}</nav></noscript>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <aside class="floating-social" aria-label="Follow Singularity Review">{{ socialLink(site.facebook, "Facebook") }}{{ socialLink(site.instagram, "Instagram") }}</aside>
  <footer class="site-footer">
    <a class="footer-brand" href="/" aria-label="Singularity Review home"><img src="/images/brand/wordmark.svg" width="292" height="28" alt="Singularity Review"></a>
    <nav class="footer-links" aria-label="Footer"><a href="/about/">About</a><a href="/rss.xml">RSS</a></nav>
    <nav class="footer-social" aria-label="Social">{{ socialLink(site.facebook, "Facebook") }}{{ socialLink(site.instagram, "Instagram") }}</nav>
    <p class="footer-copy">&copy; {{ site.year }} Singularity Review</p>
  </footer>
</body>
</html>
