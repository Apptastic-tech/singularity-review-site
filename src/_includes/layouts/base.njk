{% from "icons.njk" import icon, socialLink %}
{% from "navigation.njk" import navLinks %}
{% from "newsletter.njk" import newsletterForm %}
{%- set activeSection = page.url | navigationSection(author, site.defaultAuthor) -%}
{%- set seo = { site: site, page: page, title: title, description: description, seoDescription: seoDescription, updated: updated, pagination: pagination, homeFeed: homeFeed, cat: cat, person: person, collections: collections, feedItems: feedItems } | seoMetadata -%}
{%- set pageTitle = seo.title -%}
{%- set pageDescription = seo.description -%}
{%- set pageImage = (hero or site.defaultImage) | absoluteUrl(site.url) -%}
{%- set pageImageAlt = heroAlt or site.defaultImageAlt -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if site.legacyHosts and site.legacyHosts.length %}<script>(function(l,h,t){if(h.indexOf(l.hostname)>-1&&l.hostname!==t.replace(/^https?:\/\//,"")){l.replace(t+l.pathname+l.search+l.hash)}})(location,{{ site.legacyHosts | dump | safe }},{{ site.url | dump | safe }})</script>{% endif %}
  <title>{{ pageTitle }}</title>
  {% if site.adsense.verificationMeta or site.adsense.client %}<meta name="google-adsense-account" content="{{ site.adsense.verificationMeta or site.adsense.client }}">{% else %}<!-- AdSense verification meta placeholder: set site.adsense.verificationMeta or client after approval. -->{% endif %}
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <link rel="alternate" hreflang="en" href="{{ canonical }}">
  <link rel="alternate" hreflang="x-default" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <meta name="theme-color" content="#0B0C0E">
  <meta name="color-scheme" content="dark">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if ogType == 'article' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageImageAlt }}">
  <meta property="og:image:width" content="{{ 1280 if hero else 1200 }}">
  <meta property="og:image:height" content="{{ 720 if hero else 630 }}">
  <meta property="og:locale" content="en_US">
  {% if ogType == 'article' %}<meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:section" content="{{ category }}">
  <meta property="article:modified_time" content="{{ (updated or page.date) | isoDate }}">
  <meta property="article:author" content="{{ (authorUrl or '/about/') | absoluteUrl(site.url) }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ pageImageAlt }}">
  <link rel="icon" href="{{ '/favicon-32.png' | asset }}" type="image/png" sizes="32x32">
  <link rel="icon" href="{{ '/favicon-48.png' | asset }}" type="image/png" sizes="48x48">
  <link rel="icon" href="{{ '/favicon.svg' | asset }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/images/brand/apple-touch-icon.png' | asset }}" sizes="180x180">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/rss.xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} Atom feed" href="/atom.xml">
  <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% set storyBlockSizes = "(min-width: 1312px) 400px, (min-width: 960px) calc((100vw - 128px) / 3), (min-width: 640px) calc((100vw - 96px) / 2), 100vw" %}
  {% if hero %}{% preloadHero hero, "(min-width: 1440px) 1440px, 100vw", title %}
  {% elif feedItems and feedItems.length %}{% preloadHero feedItems[0].data.hero, "(min-width: 1312px) 1248px, (min-width: 640px) calc(100vw - 64px), 100vw" if pagination.pageNumber == 0 else storyBlockSizes, feedItems[0].data.title %}
  {% elif cat and cat.articles.length %}{% preloadHero cat.articles[0].data.hero, storyBlockSizes, cat.articles[0].data.title %}{% endif %}
  {% if person and person.articles.length %}{% preloadHero person.articles[0].data.hero, storyBlockSizes, person.articles[0].data.title %}{% endif %}
  <link rel="stylesheet" href="{{ '/css/style.css' | asset }}">
  <script src="{{ '/js/transitions.js' | asset }}"></script>
  <script src="{{ '/js/site.js' | asset }}" defer></script>
  <script src="{{ '/js/consent.js' | asset }}" defer></script>
  <script src="{{ '/js/newsletter.js' | asset }}" defer></script>
  {% if site.adsense.client or site.adsense.preview %}<script src="{{ '/js/ads.js' | asset }}" data-ad-client="{{ site.adsense.client }}" data-ad-preview="{{ 'true' if site.adsense.preview else 'false' }}" defer></script>{% endif %}
  {% if homeFeed and pagination.pageNumber == 0 %}<script type="module" src="{{ '/js/lensing.js' | asset }}"></script>{% endif %}
  {% if hasCarousel and collections.featured.length and (not homeFeed or pagination.pageNumber == 0) %}<script src="{{ '/js/carousel.js' | asset }}" defer></script>{% endif %}
  <script type="application/ld+json">{% if jsonld %}{{ jsonld | safe }}{% else %}{% seoGraph %}{% endif %}</script>
</head>
<body{% if homeFeed and pagination.pageNumber == 0 %} class="skyline-home"{% endif %}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Singularity Review home"><img class="masthead-mark" src="{{ '/images/brand/mark-ai-96.png' | asset }}" srcset="{{ '/images/brand/mark-ai-96.png' | asset }} 1x, {{ '/images/brand/mark-ai-192.png' | asset }} 2x" width="40" height="40" alt="" decoding="async"><span class="brand-wordmark">Singularity Review</span></a>
      <nav class="desktop-nav" aria-label="Primary">{{ navLinks(navigation, activeSection) }}</nav>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" hidden data-menu-toggle><span></span><span></span></button>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Main menu" hidden data-menu>
      <div class="menu-links">{{ navLinks(navigation, activeSection) }}</div>
    </nav>
  </header>
  <noscript><nav class="no-js-nav" aria-label="Primary">{{ navLinks(navigation, activeSection) }}</nav></noscript>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-columns">
        <div class="footer-column footer-identity">
          <a class="footer-brand" href="/">Singularity Review</a>
          <p class="footer-description">{{ site.description }}</p>
        </div>
        <div class="footer-column">
          <h2 class="footer-heading" id="footer-sections">Sections</h2>
          <nav class="footer-links" aria-label="Sections" aria-labelledby="footer-sections">{{ navLinks(navigation, activeSection) }}</nav>
        </div>
        <div class="footer-column">
          <h2 class="footer-heading" id="footer-topics">Topics</h2>
          <nav class="footer-topics" aria-label="Topics" aria-labelledby="footer-topics">{% for topic in collections.categories %}<a href="/category/{{ topic.slug }}/"{% if cat and cat.slug == topic.slug %} aria-current="page"{% endif %}>{{ topic.name }}</a>{% endfor %}</nav>
        </div>
        <div class="footer-column">
          <h2 class="footer-heading" id="footer-follow">Follow</h2>
          <nav class="footer-social" aria-label="Follow" aria-labelledby="footer-follow">{{ socialLink(site.facebook, "Facebook", true) }}{{ socialLink(site.instagram, "Instagram", true) }}<a class="social-link social-link--text" href="/rss.xml">{{ icon("RSS") }}<span>RSS</span></a></nav>
        </div>
      </div>
      <section class="newsletter-inline newsletter-footer" aria-labelledby="newsletter-footer-heading">
        <h2 id="newsletter-footer-heading">Get the newsletter</h2>
        {{ newsletterForm("footer") }}
      </section>
      <div class="footer-bottom">
        <p class="footer-copy">&copy; {{ site.year }} Singularity Review</p>
        <nav class="footer-legal" aria-label="Legal" aria-labelledby="footer-legal-heading"><h2 class="footer-heading footer-legal-title" id="footer-legal-heading">Legal</h2><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/editorial-standards/">Editorial standards</a><a href="/privacy/">Privacy</a><a href="/cookies/">Cookies</a><a href="/terms/">Terms</a><button class="privacy-link" type="button" data-consent-open hidden>Cookie settings</button></nav>
        <p class="photo-credit skyline-credit">Skyline: <a href="https://commons.wikimedia.org/wiki/File:Kitt_Peak_at_Night_(3S8A6804).jpg">Kitt Peak at Night</a>, KPNO/NOIRLab/NSF/AURA/P. Marenfeld, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Colour graded; satellite trail removed.</p>
      </div>
    </div>
  </footer>
  {% include "privacy-controls.njk" %}
</body>
</html>
