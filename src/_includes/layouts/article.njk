---
layout: layouts/base.njk
---
{% from "icons.njk" import socialLink %}
{% from "share.njk" import shareBar with context %}
{% from "byline.njk" import byline %}
{% from "newsletter.njk" import newsletterForm %}
{%- set shareUrl = page.url | absoluteUrl(site.url) -%}
<article class="article">
  <header class="article-header reading-width">
    <a class="category-label category-link" href="/category/{{ category | slugify }}/">{{ category }}</a>
    {% if opinion %}<p class="plain-label">Opinion</p>{% endif %}
    <h1 class="article-title">{{ title | sentenceTitle }}</h1>
    <p class="article-dek">{{ description }}</p>
    <p class="byline meta">{{ byline(author, authorUrl, page.date, content | readingTime) }}</p>
    {{ shareBar(shareUrl, title, "compact") }}
  </header>
  {% if takeaways.length %}<section class="article-takeaways reading-width" aria-labelledby="takeaways-heading">
    <h2 id="takeaways-heading">Key takeaways</h2>
    <ul>{% for takeaway in takeaways %}<li>{{ takeaway }}</li>{% endfor %}</ul>
  </section>{% endif %}
  <figure class="article-hero" data-article-hero>
    {% picture hero, heroAlt, "(min-width: 1440px) 1440px, 100vw", "eager", "high", "hero-image", title %}
    {% if heroCaption %}<figcaption>{{ heroCaption }}</figcaption>{% endif %}
  </figure>
  <div class="prose reading-width article-body">{{ content | safe }}</div>
  <footer class="article-footer reading-width">
    {% include "reactions.njk" %}
    <div class="share-end">
      <p class="plain-label">Share this article</p>
      {{ shareBar(shareUrl, title, "full") }}
    </div>
    {% if tags.length %}<ul class="tags" aria-label="Article topics">{% for tag in tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
    <div class="follow">
      <p class="plain-label">Follow Singularity Review</p>
      <div class="follow-links">{{ socialLink(site.facebook, "Facebook", true) }}{{ socialLink(site.instagram, "Instagram", true) }}</div>
    </div>
    {% if sources.length %}<section class="article-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ol>{% for source in sources %}<li><a href="{{ source.url }}" rel="noopener">{% if source.publisher %}{{ source.publisher }}, {% endif %}{{ source.title }}</a>{% if source.date %}, <time datetime="{{ source.date }}">{{ source.date }}</time>{% endif %}</li>{% endfor %}</ol>
    </section>{% endif %}
    <section class="newsletter-inline newsletter-article" aria-labelledby="newsletter-article-end-heading">
      <h2 id="newsletter-article-end-heading">Get the newsletter</h2>
      <p class="newsletter-description">The week's AI news, research and analysis.</p>
      {{ newsletterForm("article-end") }}
    </section>
  </footer>
</article>
{% set more = collections.articles | exclude(page.url) | limit(4) %}
{% if more.length %}<section class="read-next feed-width" aria-labelledby="next-heading">
  <h2 class="section-title" id="next-heading">Read next</h2>
  <div class="story-grid" data-feed>{% set storyHeading = "h3" %}{% asyncEach item in more %}{% include "story-block.njk" %}{% endeach %}</div>
</section>{% endif %}
<script src="{{ '/js/article.js' | asset }}" defer></script>
