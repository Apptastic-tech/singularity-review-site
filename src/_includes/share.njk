{#- Share bar. Plain share URLs only: no third-party SDKs or trackers. -#}
{% macro svg(name) %}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">{{ shareIcons[name] | safe }}</svg>{% endmacro %}
{% macro shareBar(url, title, variant="full") %}
{%- set u = url | urlencode -%}
{%- set t = title | urlencode -%}
{%- set targets = [
  ["facebook", "Facebook", "https://www.facebook.com/sharer/sharer.php?u=" + u],
  ["x", "X", "https://x.com/intent/post?url=" + u + "&text=" + t],
  ["linkedin", "LinkedIn", "https://www.linkedin.com/sharing/share-offsite/?url=" + u],
  ["threads", "Threads", "https://www.threads.net/intent/post?text=" + t + "%20" + u],
  ["whatsapp", "WhatsApp", "https://wa.me/?text=" + t + "%20" + u],
  ["telegram", "Telegram", "https://t.me/share/url?url=" + u + "&text=" + t],
  ["reddit", "Reddit", "https://www.reddit.com/submit?url=" + u + "&title=" + t]
] -%}
<div class="share-bar share-bar--{{ variant }}" role="group" aria-label="Share this article">
  <button type="button" class="share-control" data-share-native data-url="{{ url }}" data-title="{{ title }}" hidden>{{ svg("share") }}<span>Share</span></button>
  {% for item in targets %}{% if variant == "full" or item[0] in ["facebook", "x", "whatsapp"] %}<a class="share-btn" href="{{ item[2] }}" target="_blank" rel="noopener noreferrer" aria-label="Share on {{ item[1] }} (opens in a new tab)">{{ svg(item[0]) }}</a>{% endif %}{% endfor %}
  {% if variant == "full" %}<a class="share-btn" href="mailto:?subject={{ t }}&amp;body={{ t }}%0A%0A{{ u }}" aria-label="Share by email">{{ svg("email") }}</a>{% endif %}
  <button type="button" class="share-control" data-share-copy data-url="{{ url }}">{{ svg("link") }}<span data-copy-label>Copy link</span></button>
</div>
{% endmacro %}
