{% macro icon(name) %}
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
{% if name == "Facebook" %}<path fill="currentColor" d="M14 22v-9h3l.5-4H14V7c0-1 .3-2 2-2h2V1.5C17.4 1.4 16.3 1.3 15 1.3c-3 0-5 1.8-5 5.2V9H7v4h3v9z"/>{% elif name == "Instagram" %}<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>{% else %}<path d="M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="5" cy="19" r="1.7" fill="currentColor"/>{% endif %}
</svg>
{% endmacro %}
{% macro socialLink(url, name, text=false) %}<a href="{{ url }}" class="social-link{% if text %} social-link--text{% endif %}" rel="noopener" target="_blank" aria-label="Singularity Review on {{ name }}">{{ icon(name) }}{% if text %}<span>{{ name }}</span>{% endif %}</a>{% endmacro %}
