{#- Follow icons reuse the monochrome share marks (simple-icons, CC0). Import with context so shareIcons is available. -#}
{% macro icon(name) %}
{%- set key = name | lower -%}
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
{% if shareIcons and shareIcons[key] %}{{ shareIcons[key] | safe }}{% else %}<path d="M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="5" cy="19" r="1.7" fill="currentColor"/>{% endif %}
</svg>
{% endmacro %}
{% macro socialLink(url, name, text=false) %}<a href="{{ url }}" class="social-link{% if text %} social-link--text{% endif %}" rel="noopener" target="_blank" aria-label="Singularity Review on {{ name }}">{{ icon(name) }}{% if text %}<span>{{ name }}</span>{% endif %}</a>{% endmacro %}
{% macro followLinks(site, text=false) %}{{ socialLink(site.facebook, "Facebook", text) }}{{ socialLink(site.instagram, "Instagram", text) }}{{ socialLink(site.telegram, "Telegram", text) }}{% endmacro %}
