<article class="card{% if featured %} card--featured{% endif %}{% if lead %} card--lead{% endif %}" data-card data-reveal>
  <a class="card-link" href="{{ item.url }}" aria-labelledby="title-{{ item.data.title | slugify }}" data-story-link>
    <div class="card-body">
      <div class="card-meta"><span class="category-label">{{ item.data.category }}</span><time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time></div>
      <{{ "h1" if lead else "h2" }} class="card-title" id="title-{{ item.data.title | slugify }}">{{ item.data.title }}</{{ "h1" if lead else "h2" }}>
      {% if lead %}<p class="lead-byline meta">By {{ item.data.author or site.defaultAuthor }}</p>{% endif %}
      <p class="card-dek">{{ item.data.description }}</p>
    </div>
    <div class="card-media">
      {% picture item.data.hero, item.data.heroAlt, "(min-width: 1312px) 1248px, (min-width: 640px) calc(100vw - 64px), 100vw", "eager" if featured else "lazy", "high" if featured else "auto", "card-image", item.data.title %}
    </div>
  </a>
</article>
