{#- Newsletter signup: the beehiiv embed form is mounted here by /js/newsletter.js only when the signup is shown or near view. -#}
{% macro newsletterForm(source) %}
<div class="newsletter-embed" data-newsletter-embed data-source="{{ source }}">
  <div class="newsletter-embed-frame" data-newsletter-frame></div>
  <a class="privacy-button newsletter-fallback" href="https://singularity-newsletter.beehiiv.com/" target="_blank" rel="noopener">Subscribe to the newsletter</a>
  <p class="newsletter-note">Signups are handled by beehiiv. <a class="newsletter-privacy" href="/privacy/">Privacy policy</a></p>
</div>
{% endmacro %}
