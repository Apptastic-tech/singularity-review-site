{#- Anonymous reactions. Counts live in Firestore sr_reactions/{slug}; src/js/article.js loads them when this block nears the viewport. -#}
{%- set reactionSlug = page.url | replace("/articles/", "") | replace("/", "") -%}
<section class="reactions" data-reactions data-slug="{{ reactionSlug }}" aria-labelledby="reactions-heading" hidden>
  <h2 class="kicker" id="reactions-heading">Reactions</h2>
  <div class="reaction-list" role="group" aria-label="React to this article">
    <button type="button" class="reaction reaction--like" data-key="like" data-label="Like" aria-pressed="false" aria-label="Like"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">{{ shareIcons.heart | safe }}</svg><span class="reaction-count" data-count></span></button>
    {% for r in [["up", "👍", "Thumbs up"], ["fire", "🔥", "Fire"], ["mind", "🤯", "Mind blown"], ["think", "🤔", "Thinking"], ["sad", "😢", "Sad"]] %}<button type="button" class="reaction" data-key="{{ r[0] }}" data-label="{{ r[2] }}" aria-pressed="false" aria-label="{{ r[2] }}"><span class="reaction-emoji" aria-hidden="true">{{ r[1] }}</span><span class="reaction-count" data-count></span></button>{% endfor %}
  </div>
</section>
