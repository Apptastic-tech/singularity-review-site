---
layout: layouts/base.njk
pagination:
  data: collections.categories
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ cat.name }}"
  description: "{{ cat.name }} coverage from Singularity Review: AI news for people living through the singularity."
---
<header class="feed-intro category-intro feed-width">
  <p class="kicker">The {{ cat.name }} section</p>
  <h1>{{ cat.name }}</h1>
  <p class="meta">{{ cat.articles.length }} {{ "story" if cat.articles.length == 1 else "stories" }}, newest first</p>
</header>
<section class="feed feed-width" aria-label="{{ cat.name }} articles" data-feed>
  {% asyncEach item in cat.articles %}{% set featured = loop.first %}{% include "card.njk" %}{% endeach %}
</section>
