---
layout: layouts/base.njk
title: Singularity headline news
description: "AI news, research, and analysis"
pagination:
  data: collections.headlines
  size: 10
  alias: feedItems
  generatePageOnEmptyData: true
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
homeFeed: true
hasCarousel: true
eleventyExcludeFromCollections: true
---
{% if pagination.pageNumber == 0 %}
<div class="night-cover" data-cover>
  <div class="cover-sky" aria-hidden="true">{% brandPicture "skyline-kittpeak", "(max-width: 255px) 255px, 100vw", "cover-sky-image", "low" %}</div>
  <div class="cover-disk" aria-hidden="true">{% brandPicture "blackhole-wide", "(min-width: 640px) 320px, 260px", "cover-disk-image", "low" %}</div>
  <canvas class="cover-lensing" data-lensing aria-hidden="true" width="1" height="1"></canvas>
  <button type="button" class="cover-motion" aria-label="Pause sky animation" aria-pressed="false" data-motion-toggle hidden><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path data-motion-glyph d="M7 5h3v14H7zm7 0h3v14h-3z" fill="currentColor"/></svg></button>
</div>
{% else %}
<header class="feed-intro feed-width">
  <h1>Singularity headline news</h1>
  {% if pagination.pageNumber > 0 %}<p class="meta">Page {{ pagination.pageNumber + 1 }}</p>{% endif %}
</header>
{% endif %}
<section class="feed headline-feed feed-width" aria-label="Singularity headline news" data-feed>
  {% if feedItems.length %}
  {% asyncEach item in feedItems %}
    {% set featured = loop.first %}
    {% set lead = loop.first and pagination.pageNumber == 0 %}
    {% include "card.njk" %}
    {% ifAsync loop.first and pagination.pageNumber == 0 and collections.featured.length %}
      {% set carouselItems = collections.featured %}
      {% include "carousel.njk" %}
    {% endif %}
  {% endeach %}
  {% else %}<header class="feed-intro"><h1>Latest news</h1><p class="empty-state">No headline articles are published yet. Read <a href="/featured/">Featured author articles</a>.</p></header>{% endif %}
</section>
{% ifAsync not feedItems.length and pagination.pageNumber == 0 and collections.featured.length %}
  {% set carouselItems = collections.featured %}
  {% include "carousel.njk" %}
{% endif %}
<nav class="pagination feed-width" aria-label="Article pages">
  {% if pagination.href.previous %}<a class="page-link" href="{{ pagination.href.previous }}">Previous page</a>{% endif %}
  {% if pagination.href.next %}
  <div data-sentinel></div>
  <a class="page-link load-more" href="{{ pagination.href.next }}" data-load-more>Load more</a>
  <p class="load-status meta" role="status" aria-live="polite" data-load-status></p>
  {% endif %}
</nav>
