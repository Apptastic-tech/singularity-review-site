---
layout: layouts/base.njk
title: Singularity headline news
description: "AI news, research, and analysis"
pagination:
  data: collections.headlines
  size: 10
  alias: feedItems
  generatePageOnEmptyData: true
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
homeFeed: true
hasCarousel: true
eleventyExcludeFromCollections: true
---
{% ifAsync pagination.pageNumber == 0 %}
<div class="night-cover" data-cover>
  <div class="cover-atmosphere" aria-hidden="true">
  <div class="cover-sky" aria-hidden="true">{% brandPicture "skyline-kittpeak", "(max-width: 639px) 640px, 100vw", "cover-sky-image", "low" %}</div>
  <div class="cover-disk" aria-hidden="true">{% brandPicture "blackhole-wide", "(min-width: 854px) 640px, (min-width: 640px) 75vw, calc(100vw - 48px)", "cover-disk-image", "low" %}</div>
  <canvas class="cover-lensing" data-lensing aria-hidden="true" width="1" height="1"></canvas>
  </div>
  <header class="hero-statement">
    <h1>The singularity is already here.</h1>
    <p class="hero-description">So many AI breakthroughs land every day that it's hard to keep up. We help you focus on what matters and leave out the noise.</p>
  </header>
  <button type="button" class="cover-motion" aria-label="Pause sky animation" aria-pressed="false" data-motion-toggle hidden><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path data-motion-glyph d="M7 5h3v14H7zm7 0h3v14h-3z" fill="currentColor"/></svg></button>
</div>
{% set rowItems = feedItems %}
{% set rowTitle = "Singularity headline news" %}
{% set rowId = "headline-news" %}
{% set rowTarget = pagination.href.next %}
{% set cardEager = true %}
{% include "card-row.njk" %}
{% set name = "homeGrid" %}
{% if site.adsense.client or site.adsense.preview %}<div class="home-ad feed-width">{% include "ad-slot.njk" %}</div>{% endif %}
{% ifAsync collections.featured.length %}
  {% set carouselItems = collections.featured %}
  {% include "carousel.njk" %}
{% endif %}
{% else %}
<header class="feed-intro feed-width">
  <h1>Singularity headline news</h1>
  <p class="meta">Page {{ pagination.pageNumber + 1 }}</p>
</header>
<section class="post-grid feed-width" aria-label="Singularity headline news" data-feed>
  {% set cardHeading = "h2" %}
  {% set cardEager = true %}
  {% asyncEach item in feedItems %}{% include "post-card.njk" %}{% endeach %}
</section>
<nav class="pagination feed-width" aria-label="Article pages">
  {% if pagination.href.previous %}<a class="page-link" href="{{ pagination.href.previous }}">Previous page</a>{% endif %}
  {% if pagination.href.next %}
  <div data-sentinel></div>
  <a class="page-link load-more" href="{{ pagination.href.next }}" data-load-more>Load more</a>
  <p class="load-status meta" role="status" aria-live="polite" data-load-status></p>
  {% endif %}
</nav>
{% endif %}
