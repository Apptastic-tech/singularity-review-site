---
layout: layouts/base.njk
title: Featured
description: "Personal perspectives, reviews and analysis from the authors of Singularity Review."
permalink: /featured/
hasCarousel: true
eleventyExcludeFromCollections: true
---
<header class="feed-intro feed-width">
  <h1>Featured</h1>
</header>
{% ifAsync collections.featured.length %}
  {% set carouselItems = collections.featured %}
  {% include "carousel.njk" %}
  <section class="feed feed-width" aria-labelledby="featured-archive">
    <h2 class="archive-title" id="featured-archive">All featured articles</h2>
    {% asyncEach item in collections.featured %}{% set featured = false %}{% include "card.njk" %}{% endeach %}
  </section>
{% else %}<p class="empty-state reading-width">Our authors' next articles will appear here. Read the latest <a href="/">News</a>.</p>{% endif %}
